<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/SoftInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="¿Qué tienes que hacer?">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialog_note_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/dialog_trigger_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:checkedChip="@+id/dlg_arrive"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/dlg_arrive"
            style="@style/SoftChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Al llegar"
            app:chipIcon="@drawable/ic_arrive" />

        <com.google.android.material.chip.Chip
            android:id="@+id/dlg_leave"
            style="@style/SoftChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Al salir"
            app:chipIcon="@drawable/ic_leave" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>

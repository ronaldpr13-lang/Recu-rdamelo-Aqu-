<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Mapa grande -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Pin fijo: la punta queda justo en el centro del mapa -->
        <ImageView
            android:id="@+id/center_pin"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginBottom="48dp"
            android:contentDescription="Punto escogido"
            android:elevation="4dp"
            android:src="@drawable/pin_center" />

        <!-- Atrás + buscador flotantes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                style="@style/MapRoundButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Volver"
                app:icon="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="6dp">

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Buscar dirección o lugar"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_soft"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_search"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Buscar"
                    app:icon="@drawable/ic_search"
                    app:iconTint="@color/text_soft" />
            </LinearLayout>
        </LinearLayout>

        <!-- Brújula: aparece cuando giras el mapa; tócala para volver al norte -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_north"
            style="@style/MapRoundButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="76dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Poner el norte arriba"
            android:visibility="gone"
            app:icon="@drawable/ic_north"
            app:iconTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_expand"
            style="@style/MapRoundButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="104dp"
            android:contentDescription="Ver mapa completo"
            app:icon="@drawable/ic_fullscreen" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_point"
            style="@style/PillButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:elevation="4dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Usar este punto"
            android:visibility="gone"
            app:icon="@drawable/ic_check" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_location"
            style="@style/MapRoundButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="40dp"
            android:contentDescription="Ir a mi ubicación"
            app:icon="@drawable/ic_my_location"
            app:iconTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="30dp"
            android:alpha="0.7"
            android:text="© OpenStreetMap"
            android:textColor="@color/text_soft"
            android:textSize="10sp" />
    </FrameLayout>

    <!-- Panel inferior -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_sheet"
        android:elevation="8dp"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_handle" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/sheet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Nuevo recordatorio"
                    android:textColor="@color/text"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/address_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="Buscando dirección…"
                    android:textColor="@color/text_soft"
                    android:textSize="14sp"
                    app:drawableStartCompat="@drawable/ic_pin"
                    app:drawableTint="@color/primary" />

                <TextView
                    android:id="@+id/gps_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/new_note_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/note_layout"
                        style="@style/SoftInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="¿Qué tienes que hacer aquí?">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/note_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/trigger_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:checkedChip="@+id/chip_arrive"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_arrive"
                            style="@style/SoftChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Al llegar"
                            app:chipIcon="@drawable/ic_arrive" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_leave"
                            style="@style/SoftChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Al salir"
                            app:chipIcon="@drawable/ic_leave" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <!-- Distancia -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Distancia del aviso"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/radius_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/radius_slider"
                    style="@style/SoftSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Distancia del aviso"
                    android:stepSize="10"
                    android:value="200"
                    android:valueFrom="30"
                    android:valueTo="2000" />

                <TextView
                    android:id="@+id/radius_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-6dp"
                    android:textColor="@color/text_soft"
                    android:textSize="12sp" />

                <!-- Nombre -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Nombre (opcional)"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/name_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            style="@style/SoftChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Casa" />

                        <com.google.android.material.chip.Chip
                            style="@style/SoftChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trabajo" />

                        <com.google.android.material.chip.Chip
                            style="@style/SoftChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Supermercado" />

                        <com.google.android.material.chip.Chip
                            style="@style/SoftChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Colmado" />

                        <com.google.android.material.chip.Chip
                            style="@style/SoftChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Farmacia" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_other"
                            style="@style/SoftChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Otro…" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/name_layout"
                    style="@style/SoftInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Nombre del lugar"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save"
                    style="@style/PillButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Guardar" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
